{
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "devtools-kit",
      "description": "开发工具箱：聚合高频开发辅助工具",
      "cmds": ["开发工具箱", "工具箱", "devtools"]
    },
    {
      "code": "timestamp",
      "description": "时间戳与日期时间双向转换",
      "cmds": [
        "时间戳",
        "时间戳转换",
        "timestamp",
        {
          "type": "regex",
          "label": "时间戳转换",
          "match": "/^\\d{8,13}$/",
          "minLength": 8,
          "maxLength": 13
        }
      ]
    },
    {
      "code": "base64",
      "description": "Base64 编码与解码，自动识别方向",
      "cmds": ["base64", "Base64转码", "base64编码"]
    },
    {
      "code": "base32",
      "description": "RFC 4648 Base32 编码与解码",
      "cmds": ["base32", "Base32转码", "base32编码"]
    },
    {
      "code": "file-b64",
      "description": "图片/文件转 Base64 / Data URL，支持预览与另存为",
      "cmds": ["图片转Base64", "文件转Base64", "base64图片", "file2b64"]
    },
    {
      "code": "url-codec",
      "description": "URL 编码解码与查询参数解析",
      "cmds": [
        "url编码",
        "url解码",
        "URL编解码",
        {
          "type": "regex",
          "label": "URL 编解码",
          "match": "/^https?:\\/\\/\\S+$/i",
          "minLength": 8,
          "maxLength": 2000
        }
      ]
    },
    {
      "code": "json",
      "description": "JSON 格式化、压缩与校验定位",
      "cmds": [
        "json",
        "JSON格式化",
        "json校验",
        {
          "type": "regex",
          "label": "JSON 格式化",
          "match": "/^[{\\[][{\\[\\s\\S]*[}\\]]$/",
          "minLength": 2,
          "maxLength": 1000000
        }
      ]
    },
    {
      "code": "radix",
      "description": "2/8/10/16 进制互转，大数安全",
      "cmds": ["进制转换", "进制", "hex转十进制"]
    },
    {
      "code": "uuid",
      "description": "UUID v4 批量生成",
      "cmds": [
        "uuid",
        "UUID生成",
        "guid",
        {
          "type": "regex",
          "label": "UUID 校验",
          "match": "/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i",
          "minLength": 36,
          "maxLength": 36
        }
      ]
    },
    {
      "code": "date-calc",
      "description": "日期换算：农历、星期、年内序数、日期差",
      "cmds": ["日期换算", "农历", "日期计算", "datecalc"]
    },
    {
      "code": "hash",
      "description": "MD5 / SHA-1 / SHA-256 / SHA-512 哈希计算",
      "cmds": ["哈希", "hash", "md5", "sha"]
    },
    {
      "code": "aes",
      "description": "AES-CBC / GCM 对称加解密，密钥一键生成",
      "cmds": ["AES加密", "AES解密", "AES", "aes"]
    },
    {
      "code": "rsa",
      "description": "RSA 密钥对、加解密与签名验签",
      "cmds": ["RSA加密", "RSA解密", "RSA", "rsa"]
    },
    {
      "code": "unicode",
      "description": "Unicode 转义序列与中文互转",
      "cmds": ["unicode", "unicode转中文"]
    },
    {
      "code": "encoding",
      "description": "GBK / UTF-8 / UTF-16 编码转换与乱码复原",
      "cmds": ["编码转换", "GBK", "乱码", "encoding"]
    },
    {
      "code": "case-convert",
      "description": "命名风格转换：camel / snake / kebab 等五种",
      "cmds": ["命名转换", "驼峰转换"]
    },
    {
      "code": "text-stat",
      "description": "文本统计：字符数、单词数、行数、字节数",
      "cmds": ["文本统计", "字数统计"]
    },
    {
      "code": "qrcode",
      "description": "文本转二维码，本地生成可复制",
      "cmds": ["二维码", "qrcode"]
    },
    {
      "code": "color",
      "description": "颜色格式转换：HEX / RGB / HSL 互转",
      "cmds": [
        "颜色转换",
        "color",
        "取色",
        {
          "type": "regex",
          "label": "颜色转换",
          "match": "/^#([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$|^rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(,[\\s\\d.]+)?\\s*\\)$|^hsla?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}%\\s*,\\s*\\d{1,3}%\\s*(,[\\s\\d.]+)?\\s*\\)$/i",
          "minLength": 4,
          "maxLength": 60
        }
      ]
    }
  ]
}
