{
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "devtools-kit",
      "description": "开发工具箱：聚合高频开发辅助工具",
      "cmds": ["开发工具箱", "工具箱", "devtools"]
    },
    {
      "code": "timestamp",
      "description": "时间戳与日期时间双向转换",
      "cmds": ["时间戳", "时间戳转换", "timestamp"]
    },
    {
      "code": "base64",
      "description": "Base64 编码与解码，自动识别方向",
      "cmds": ["base64", "Base64转码", "base64编码"]
    },
    {
      "code": "url-codec",
      "description": "URL 编码解码与查询参数解析",
      "cmds": ["url编码", "url解码", "URL编解码"]
    },
    {
      "code": "json",
      "description": "JSON 格式化、压缩与校验定位",
      "cmds": ["json", "JSON格式化", "json校验"]
    },
    {
      "code": "radix",
      "description": "2/8/10/16 进制互转，大数安全",
      "cmds": ["进制转换", "进制", "hex转十进制"]
    },
    {
      "code": "uuid",
      "description": "UUID v4 批量生成",
      "cmds": ["uuid", "UUID生成", "guid"]
    },
    {
      "code": "date-calc",
      "description": "日期换算：农历、星期、年内序数、日期差",
      "cmds": ["日期换算", "农历", "日期计算", "datecalc"]
    },
    {
      "code": "hash",
      "description": "MD5 / SHA-1 / SHA-256 / SHA-512 哈希计算",
      "cmds": ["哈希", "hash", "md5", "sha"]
    },
    {
      "code": "unicode",
      "description": "Unicode 转义序列与中文互转",
      "cmds": ["unicode", "unicode转中文"]
    },
    {
      "code": "case-convert",
      "description": "命名风格转换：camel / snake / kebab 等五种",
      "cmds": ["命名转换", "驼峰转换"]
    },
    {
      "code": "text-stat",
      "description": "文本统计：字符数、单词数、行数、字节数",
      "cmds": ["文本统计", "字数统计"]
    },
    {
      "code": "qrcode",
      "description": "文本转二维码，本地生成可复制",
      "cmds": ["二维码", "qrcode"]
    },
    {
      "code": "color",
      "description": "颜色格式转换：HEX / RGB / HSL 互转",
      "cmds": ["颜色转换", "color", "取色"]
    }
  ]
}
